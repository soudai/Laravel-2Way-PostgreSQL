{
    "name": "soudai/laravel-2way-postgresql",
    "description": "PostgreSQL two-way SQL templates for Laravel",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "ext-pdo_pgsql": "*",
        "ext-mbstring": "*",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "conflict": {
        "phpstan/phpstan": "<2.1.3"
    },
    "autoload": {
        "psr-4": {
            "Hft\\TwoWaySql\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hft\\TwoWaySql\\Laravel\\TwoWaySqlServiceProvider"
            ]
        }
    }
}
